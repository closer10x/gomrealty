# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://cyexunowpxuflcmtpxbn.supabase.co
# Project Settings -> API -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- RealtyAPI (realtor.realtyapi.io) ----------
# Dashboard: https://www.realtyapi.io  -> sent as the `x-realtyapi-key` header.
# SERVER ONLY: every call is proxied through /api/realty/* so the key never reaches the browser.
REALTYAPI_KEY=
REALTYAPI_BASE_URL=https://realtor.realtyapi.io
# Redfin runs on the same key, different host — neighborhood/schools/climate data.
REDFIN_API_BASE_URL=https://redfin.realtyapi.io

# ---------- Map ----------
# The map runs on MapLibre + CARTO's Positron basemap, which needs no key or
# account. Set this only to swap the basemap (e.g. a MapTiler or self-hosted
# style URL) for branded styling.
NEXT_PUBLIC_MAP_STYLE=

# ---------- Google Places (address autocomplete / autofill) ----------
# Places API (New). Enable "Places API (New)" in Google Cloud, then restrict the
# key to that API. SERVER ONLY — proxied via /api/places/autocomplete, so it is
# never sent to the browser and cannot be scraped from the page source.
# Without it the search box simply has no suggestions.
GOOGLE_PLACES_API_KEY=
# Bias suggestions toward the service area. "us" keeps it national.
GOOGLE_PLACES_REGION=us
# Autocomplete uses RealtyAPI by default. Flip to true only once "Places API
# (New)" is enabled and billed on the Google Cloud project, or every keystroke
# pays for a failed Google call before falling back.
GOOGLE_PLACES_ENABLED=false

# ---------- Site ----------
# Default market used by the homepage map/listing panel.
NEXT_PUBLIC_DEFAULT_LOCATION=Houston, TX
NEXT_PUBLIC_SITE_URL=http://localhost:3200

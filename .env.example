# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://cyexunowpxuflcmtpxbn.supabase.co
# Project Settings -> API -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- RealtyAPI (realtor.realtyapi.io) ----------
# Dashboard: https://www.realtyapi.io  -> sent as the `x-realtyapi-key` header.
# SERVER ONLY: every call is proxied through /api/realty/* so the key never reaches the browser.
REALTYAPI_KEY=
REALTYAPI_BASE_URL=https://realtor.realtyapi.io
# Redfin runs on the same key, different host — neighborhood/schools/climate data.
REDFIN_API_BASE_URL=https://redfin.realtyapi.io

# ---------- Map (Mapbox) ----------
# Public token (pk.…) from https://account.mapbox.com — safe in the browser;
# scope it to your domains under URL restrictions. Without it the hero falls
# back to the comp's decorative map.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional Studio style to match the comp's palette; defaults to light-v11.
NEXT_PUBLIC_MAPBOX_STYLE=

# ---------- Site ----------
# Default market used by the homepage map/listing panel.
NEXT_PUBLIC_DEFAULT_LOCATION=Houston, TX
NEXT_PUBLIC_SITE_URL=http://localhost:3200
